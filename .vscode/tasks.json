{
  "version": "2.0.0",
  "tasks": [
    {
      "type": "shell",
      "label": "C/C++: g++.exe build active file with TBB",
      "command": "g++",
      "args": [
        "-fdiagnostics-color=always",
        "-g",
        "-O3",
        "-std=c++17",
        "-I${workspaceFolder}\\mingw64\\include",
        "${file}",
        "${workspaceFolder}\\libtbb12.dll",
        "-o",
        "${fileDirname}\\${fileBasenameNoExtension}.exe"
      ],
      "options": {
        "cwd": "${fileDirname}",
        "env": {
          "PATH": "${workspaceFolder}\\w64devkit\\bin;${workspaceFolder};${env:PATH}"
        }
      },
      "problemMatcher": [
        "$gcc"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "detail": "Compiler: w64devkit GCC with oneTBB"
    }
  ]
}